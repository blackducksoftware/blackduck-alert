<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">
    <changeSet author="martinch" id="raw-notification-content-sequence-increment">
        <alterSequence schemaName="alert"
                       sequenceName="raw_notification_content_id_seq"
                       incrementBy="1"
        />
    </changeSet>

    <!-- On an upgrade, set the sequence to be safely past the max id already in raw_notification_content -->
    <changeSet author="martinch" id="raw-notification-content-sequence-advance-past-max-id">
        <sql>
            SELECT setval(
                           'alert.raw_notification_content_id_seq',
                           GREATEST(
                                   (SELECT COALESCE(MAX(id), 1) FROM alert.raw_notification_content),
                                   (SELECT last_value FROM alert.raw_notification_content_id_seq)
                           )
                   );
        </sql>
    </changeSet>
</databaseChangeLog>
